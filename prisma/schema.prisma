// prisma/schema.prisma
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Définir une énumération pour le sexe
enum Sexe {
  HOMME
  FEMME
}

// Définir une énumération pour le rôle de l'utilisateur
enum Role {
  SIMPLE
  ADMINISTRATEUR
}

model Travailleur {
  id_travailleur String @id @default(auto()) @map("_id") @db.ObjectId
  codeMenage     Int @unique
  nom_travailleur String
  sexe_travailleur Sexe
  age_travailleur Int
  cin_travailleur Int @unique
  imageUrl_travailleur String
  nomMere_travailleur String
  conjoint       Conjoint?
  enfants        Enfant[]
  remplacant     Remplacant?
  role           Role // Ajouter le champ pour le rôle de l'utilisateur
}

model Conjoint {
  id_conjoint String @id @default(auto()) @map("_id") @db.ObjectId
  nom_conjoint String
  sexe_conjoint Sexe
  age_conjoint Int
  cin_conjoint Int? @unique
  imageUrl_conjoint String
  nomMere_conjoint String?
  travailleur Travailleur @relation(fields: [travailleurId], references: [id_travailleur])
  travailleurId String @unique @db.ObjectId
  remplacant Remplacant?
}

model Enfant {
  id_enfant String @id @default(auto()) @map("_id") @db.ObjectId
  nom_enfant String
  sexe_enfant Sexe
  age_enfant Int
  cin_enfant Int? @unique
  imageUrl_enfant String
  nomMere_enfant String?
  travailleur Travailleur @relation(fields: [travailleurId], references: [id_travailleur])
  travailleurId String @db.ObjectId
  remplacant Remplacant?
}

model Remplacant {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  travailleur Travailleur @relation(fields: [travailleurId], references: [id_travailleur])
  travailleurId String @unique @db.ObjectId

  conjoint Conjoint? @relation(fields: [conjointId], references: [id_conjoint])
  conjointId String? @unique @db.ObjectId 

  enfant Enfant? @relation(fields: [enfantId], references: [id_enfant])
  enfantId String? @unique @db.ObjectId 
}
